# Copy this file to .env and fill in the values from https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: lets the server work immediately with an existing access token.
STRAVA_ACCESS_TOKEN=
# Optional. Default is the corporate proxy configured for this workstation.
STRAVA_PROXY=http://proxy.p1at.s-group.cc:8080
# The URL configured as "Authorization Callback Domain" in Strava must allow localhost.
PORT=4173
